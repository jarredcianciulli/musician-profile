# Frontend / Docker build — baked into Next.js at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.jarredcianciulli.com/contact
NEXT_PUBLIC_STUDIO_API=https://booking-api.batterystringstudio.com
# Staging Pi .env / compose default uses Stripe-test Worker:
# NEXT_PUBLIC_STUDIO_API=https://studio-api-staging.batterystringstudio.workers.dev
NEXT_PUBLIC_WEBSITE_DOMAIN=https://batterystringstudio.com
NEXT_PUBLIC_LAB_URL=https://lab.batterystringstudio.com
NEXT_PUBLIC_METHOD_URL=https://method.batterystringstudio.com
NEXT_PUBLIC_STUDIO_EMAIL=jarred@batterystringstudio.com
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/YOUR_PAGE
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/YOUR_HANDLE

# --- Cloudflare Worker secrets (studio-api) — wrangler secret put ---
#   ADMIN_TOKEN
#   BREVO_API_KEY          (same as brevo-contact-worker; booking + lead emails)
#   STUDIO_STREET_ADDRESS
#   GOOGLE_CALENDAR_ID / GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
# Optional Price IDs: STRIPE_PRICE_30 / STRIPE_PRICE_45 / STRIPE_PRICE_60
# Bind STUDIO_KV. Webhook: https://booking-api.batterystringstudio.com/studio/booking/webhook
# Flyer QR → https://batterystringstudio.com/f/bowan-qr-01
# Emails: trial paid, subscription paid, /lead form → studio + client
