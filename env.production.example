# Frontend / Docker build only — baked into the React app at build time.
REACT_APP_CONTACT_ENDPOINT=https://api.batterystringstudio.com/contact
REACT_APP_STUDIO_API=https://api.batterystringstudio.com
REACT_APP_WEBSITE_DOMAIN=https://batterystringstudio.com
REACT_APP_LAB_URL=https://lab.batterystringstudio.com
REACT_APP_METHOD_URL=https://method.batterystringstudio.com
REACT_APP_STUDIO_EMAIL=jarred@batterystringstudio.com
REACT_APP_STUDIO_EMAIL_PERSONAL=jarred@batterystringstudio.com

# --- Cloudflare Worker secrets (studio-api) — wrangler secret put ---
#   ADMIN_TOKEN
#   STUDIO_STREET_ADDRESS
#   GOOGLE_CALENDAR_ID / GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
# Optional Price IDs: STRIPE_PRICE_30 / STRIPE_PRICE_45 / STRIPE_PRICE_60
# Bind STUDIO_KV. Webhook: https://api.batterystringstudio.com/studio/booking/webhook
# Flyer QR → https://batterystringstudio.com/trial
