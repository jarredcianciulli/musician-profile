# Staging Worker secrets — never commit real values.
# Put on Cloudflare with:
#   cd workers/studio-api
#   npx wrangler secret put STRIPE_SECRET_KEY --env staging      # sk_test_… (BSS Stripe test mode)
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET --env staging  # from test-mode webhook
#   npx wrangler secret put BREVO_API_KEY --env staging
#   npx wrangler secret put ADMIN_TOKEN --env staging
#
# Stripe Dashboard (Test mode):
#   Endpoint: https://studio-api-staging.batterystringstudio.workers.dev/studio/booking/webhook
#   (or https://booking-api-staging.batterystringstudio.com/... after Custom Domain DNS)
#   Events: checkout.session.completed, checkout.session.expired
#
# Optional after Custom Domain in CF Workers dashboard:
#   NEXT_PUBLIC_STUDIO_API=https://booking-api-staging.batterystringstudio.com
